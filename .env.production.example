# Frontend production environment
EXPO_PUBLIC_API_BASE_URL=https://your-render-service.onrender.com
EXPO_PUBLIC_AZURE_CLIENT_ID=your-production-client-id
EXPO_PUBLIC_AZURE_TENANT_ID=your-production-tenant-id
