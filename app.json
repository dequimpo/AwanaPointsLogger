{
  "expo": {
    "name": "Awana Points Logger",
    "slug": "awana-points-logger",
    "icon": "./assets/icon/DBDNJ_AwanaPointsLogger.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "appawanapointslogger",
    "extra": {
      "apiBaseUrl": "https://awanapointslogger.onrender.com",
      "azureClientId": "6c117750-8af8-4e5f-a016-136c2430b940",
      "azureTenantId": "afdc3b01-cd69-4af3-a783-9f13cce85492",
      "azureAuthScopes": "openid profile offline_access User.Read",
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.awana.pointslogger",
      "scheme": "appawanapointslogger"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/DBDNJ_AwanaPointsLogger.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.awana.pointslogger",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": {
            "scheme": "https",
            "host": "*.yourcompany.com",
            "pathPrefix": "/auth"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon/DBDNJ_AwanaPointsLogger.png"
    }
  }
}

